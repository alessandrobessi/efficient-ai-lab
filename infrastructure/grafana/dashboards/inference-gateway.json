{
  "title": "Efficient AI Lab — Inference Gateway (Week 8)",
  "uid": "inference-gateway-w8",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (by status class)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency (p50/p95/p99, /v1/generate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gateway_request_duration_seconds_bucket{path=\"POST /v1/generate\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_request_duration_seconds_bucket{path=\"POST /v1/generate\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gateway_request_duration_seconds_bucket{path=\"POST /v1/generate\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (by type)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(gateway_errors_total[1m])) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active / processing / deferred requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "gateway_active_requests", "legendFormat": "gateway active requests" },
        { "expr": "llamacpp:requests_processing", "legendFormat": "llama-server processing" },
        { "expr": "llamacpp:requests_deferred", "legendFormat": "llama-server deferred (queued)" }
      ],
      "description": "requests_deferred > 0 directly answers 'does the system queue requests?' — see FULL-ROADMAP.md's Week 8 analysis questions."
    },
    {
      "id": 5,
      "title": "Host CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU busy %"
        }
      ]
    },
    {
      "id": 6,
      "title": "Host RAM usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "(node_memory_active_bytes / node_memory_total_bytes) * 100",
          "legendFormat": "active RAM %"
        }
      ]
    },
    {
      "id": 7,
      "title": "Load average (1m/5m/15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "expr": "node_load1", "legendFormat": "1m" },
        { "expr": "node_load5", "legendFormat": "5m" },
        { "expr": "node_load15", "legendFormat": "15m" }
      ]
    },
    {
      "id": 8,
      "title": "Model throughput (decode tokens/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "llamacpp:predicted_tokens_seconds", "legendFormat": "llama-server decode tok/s (avg)" },
        { "expr": "rate(gateway_generated_tokens_total[1m])", "legendFormat": "gateway tokens/sec (rate)" }
      ]
    },
    {
      "id": 9,
      "title": "Generation duration (p50/p95/p99, upstream call only)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gateway_generation_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gateway_generation_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
