{
  "experiment": {
    "id": "1.2",
    "title": "Prompt Length",
    "date": "2026-07-10",
    "hypothesis": "Time to First Token grows with prompt length (prefill scales with prompt size), while steady-state decode speed (tokens/s) stays roughly constant regardless of prompt length, since decode only depends on the KV cache size grown during prefill, not on re-processing the prompt."
  },
  "hardware": {
    "machine": "Mac.Home",
    "cpu": "Apple M4",
    "cores": 10,
    "threads": 10,
    "ram_gb": 16.0
  },
  "software": {
    "os": "Darwin 24.6.0",
    "python": "3.14.2",
    "torch": "2.13.0",
    "transformers": "5.13.0"
  },
  "model": {
    "name": "Qwen/Qwen2.5-1.5B-Instruct",
    "parameters": "1.5B",
    "format": "safetensors (Hugging Face Transformers)",
    "quantization": "none (fp32)"
  },
  "inference": {
    "threads": 10,
    "context_size": null,
    "batch_size": 1,
    "temperature": 0.0,
    "seed": 42,
    "max_new_tokens": 64
  },
  "measurement": {
    "repetitions": 5,
    "warmup_runs": 0,
    "metrics": [
      "ttft_s",
      "decode_time_s",
      "total_time_s",
      "decode_tokens_per_s"
    ],
    "prompt_lengths_tokens": [
      32,
      128,
      512,
      1024,
      2048
    ]
  }
}